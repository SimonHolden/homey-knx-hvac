              },
              "value": 16,
              "min": 5,
              "max": 40
            },
            {
              "id": "temp_max",
              "type": "number",
              "label": {
                "en": "Maximum (°C)"
              },
              "value": 32,
              "min": 5,
              "max": 40
            },
            {
              "id": "temp_step",
              "type": "number",
              "label": {
                "en": "Step (°C)"
              },
              "value": 1,
              "min": 0.1,
              "max": 5
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Modes to expose"
          },
          "children": [
            {
              "id": "modes_hint",
              "type": "label",
              "label": {
                "en": "Tick the DPT 20.105 modes this device supports. Only ticked modes appear in the app and in flows. Without a 20.105 address, only Heat and Cool are used."
              },
              "value": ""
