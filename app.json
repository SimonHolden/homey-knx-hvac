{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.sinclair.knx-hvac",
  "version": "1.0.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "KNX HVAC"
  },
  "description": {
    "en": "KNX thermostats with full DPT 20.105 HVAC mode support, plus on/off and heat/cool objects."
  },
  "category": [
    "climate"
  ],
  "permissions": [],
  "brandColor": "#0A84C6",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Sinclair Technology",
    "email": "simon@sintech.nz"
  },
  "flow": {
    "triggers": [
      {
        "title": {
          "en": "Fan speed changed"
        },
        "tokens": [
          {
            "name": "speed",
            "type": "string",
            "title": {
              "en": "Fan speed id"
            },
            "example": {
              "en": "high"
            }
          },
          {
            "name": "speed_name",
            "type": "string",
            "title": {
              "en": "Fan speed"
            },
            "example": {
              "en": "High"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat&capabilities=fan_speed"
          }
        ],
        "id": "fan_speed_changed"
      },
      {
        "title": {
          "en": "Fan speed changed to..."
        },
        "titleFormatted": {
          "en": "Fan speed changed to [[speed]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat&capabilities=fan_speed"
          },
          {
            "type": "autocomplete",
            "name": "speed",
            "placeholder": {
              "en": "Select a fan speed"
            }
          }
        ],
        "id": "fan_speed_changed_to"
      },
      {
        "title": {
          "en": "HVAC mode changed"
        },
        "tokens": [
          {
            "name": "mode",
            "type": "string",
            "title": {
              "en": "Mode id"
            },
            "example": {
              "en": "heat"
            }
          },
          {
            "name": "mode_name",
            "type": "string",
            "title": {
              "en": "Mode"
            },
            "example": {
              "en": "Heat"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat"
          }
        ],
        "id": "hvac_mode_changed"
      },
      {
        "title": {
          "en": "HVAC mode changed to..."
        },
        "titleFormatted": {
          "en": "HVAC mode changed to [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat"
          },
          {
            "type": "autocomplete",
            "name": "mode",
            "placeholder": {
              "en": "Select a mode"
            }
          }
        ],
        "id": "hvac_mode_changed_to"
      }
    ],
    "conditions": [
      {
        "title": {
          "en": "Fan speed is..."
        },
        "titleFormatted": {
          "en": "Fan speed !{{is|is not}} [[speed]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat&capabilities=fan_speed"
          },
          {
            "type": "autocomplete",
            "name": "speed",
            "placeholder": {
              "en": "Select a fan speed"
            }
          }
        ],
        "id": "fan_speed_is"
      },
      {
        "title": {
          "en": "HVAC mode is..."
        },
        "titleFormatted": {
          "en": "HVAC mode !{{is|is not}} [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat"
          },
          {
            "type": "autocomplete",
            "name": "mode",
            "placeholder": {
              "en": "Select a mode"
            }
          }
        ],
        "id": "hvac_mode_is"
      }
    ],
    "actions": [
      {
        "title": {
          "en": "Set fan speed"
        },
        "titleFormatted": {
          "en": "Set fan speed to [[speed]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat&capabilities=fan_speed"
          },
          {
            "type": "autocomplete",
            "name": "speed",
            "placeholder": {
              "en": "Select a fan speed"
            }
          }
        ],
        "id": "set_fan_speed"
      },
      {
        "title": {
          "en": "Set HVAC mode"
        },
        "titleFormatted": {
          "en": "Set HVAC mode to [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat"
          },
          {
            "type": "autocomplete",
            "name": "mode",
            "placeholder": {
              "en": "Select a mode"
            }
          }
        ],
        "id": "set_hvac_mode"
      },
      {
        "title": {
          "en": "Set room temperature"
        },
        "titleFormatted": {
          "en": "Set room temperature to [[temperature]] °C"
        },
        "hint": {
          "en": "Tick \"Room temperature is set by a flow\" in the device settings, or set a room temperature address, for this to show on the device."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=thermostat"
          },
          {
            "type": "number",
            "name": "temperature",
            "placeholder": {
              "en": "°C"
            },
            "step": 0.1
          }
        ],
        "id": "set_room_temperature"
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "KNX Thermostat"
      },
      "class": "thermostat",
      "capabilities": [
        "onoff",
        "hvac_mode",
        "fan_speed",
        "target_temperature",
        "measure_temperature"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "min": 16,
          "max": 32,
          "step": 1
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "images": {
        "small": "/drivers/thermostat/assets/images/small.png",
        "large": "/drivers/thermostat/assets/images/large.png",
        "xlarge": "/drivers/thermostat/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "id": "thermostat",
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "On/Off (DPT 1.001)"
          },
          "children": [
            {
              "id": "ga_onoff_write",
              "type": "text",
              "label": {
                "en": "Control address"
              },
              "value": "",
              "hint": {
                "en": "Group address Homey writes to, for example 1/0/1. Leave empty if the thermostat has no on/off object."
              }
            },
            {
              "id": "ga_onoff_status",
              "type": "text",
              "label": {
                "en": "Status address"
              },
              "value": "",
              "hint": {
                "en": "Group address the device reports its state on."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Mode (DPT 20.105)"
          },
          "children": [
            {
              "id": "ga_mode_write",
              "type": "text",
              "label": {
                "en": "Control address"
              },
              "value": "",
              "hint": {
                "en": "HVAC controller mode, 1 byte."
              }
            },
            {
              "id": "ga_mode_status",
              "type": "text",
              "label": {
                "en": "Status address"
              },
              "value": ""
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Heat/Cool (DPT 1.100)"
          },
          "children": [
            {
              "id": "ga_heatcool_write",
              "type": "text",
              "label": {
                "en": "Control address"
              },
              "value": "",
              "hint": {
                "en": "Simple binary object, 0 = cool, 1 = heat. Use it on its own for thermostats without a mode object. If the 20.105 mode is also set, 20.105 is authoritative and this address is kept in sync when heat or cool is selected."
              }
            },
            {
              "id": "ga_heatcool_status",
              "type": "text",
              "label": {
                "en": "Status address"
              },
              "value": "",
              "hint": {
                "en": "Only used when no 20.105 mode address is set."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Setpoint (DPT 9.001)"
          },
          "children": [
            {
              "id": "ga_setpoint_write",
              "type": "text",
              "label": {
                "en": "Control address"
              },
              "value": ""
            },
            {
              "id": "ga_setpoint_status",
              "type": "text",
              "label": {
                "en": "Status address"
              },
              "value": ""
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Room temperature (DPT 9.001)"
          },
          "children": [
            {
              "id": "ga_temp_status",
              "type": "text",
              "label": {
                "en": "Status address"
              },
              "value": "",
              "hint": {
                "en": "For example the AC return temperature."
              }
            },
            {
              "id": "temp_from_flow",
              "type": "checkbox",
              "label": {
                "en": "Room temperature is set by a flow"
              },
              "value": false,
              "hint": {
                "en": "Shows the room temperature on the device even without a status address, so the \"Set room temperature\" flow card can update it, for example from another sensor. If both are used, whichever updated last is shown."
              }
            },
            {
              "id": "ga_temp_write",
              "type": "text",
              "label": {
                "en": "Send flow value to address"
              },
              "value": "",
              "hint": {
                "en": "Optional. The \"Set room temperature\" flow card also writes its value here (DPT 9.001), for example the external temperature input of an AC gateway. Leave empty to only update Homey."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Fan speed (DPT 5.001 / 5.010)"
          },
          "children": [
            {
              "id": "ga_fan_write",
              "type": "text",
              "label": {
                "en": "Control address"
              },
              "value": "",
              "hint": {
                "en": "Fan speed object, 1 byte."
              }
            },
            {
              "id": "ga_fan_status",
              "type": "text",
              "label": {
                "en": "Status address"
              },
              "value": ""
            },
            {
              "id": "fan_speeds",
              "type": "dropdown",
              "label": {
                "en": "Number of speeds"
              },
              "value": "3",
              "values": [
                {
                  "id": "2",
                  "label": {
                    "en": "2 (Low, High)"
                  }
                },
                {
                  "id": "3",
                  "label": {
                    "en": "3 (Low, Medium, High)"
                  }
                }
              ]
            },
            {
              "id": "fan_dpt",
              "type": "dropdown",
              "label": {
                "en": "Data type"
              },
              "value": "enum",
              "values": [
                {
                  "id": "percent",
                  "label": {
                    "en": "Percentage (DPT 5.001)"
                  }
                },
                {
                  "id": "enum",
                  "label": {
                    "en": "Enumerated (DPT 5.010)"
                  }
                }
              ],
              "hint": {
                "en": "Percentage sends 50/100 % for 2 speeds or 33/67/100 % for 3 speeds; received values snap to the nearest speed. Enumerated sends a speed number."
              }
            },
            {
              "id": "fan_enum_base",
              "type": "dropdown",
              "label": {
                "en": "Enumerated: first speed value"
              },
              "value": "1",
              "values": [
                {
                  "id": "1",
                  "label": {
                    "en": "1 (speeds 1, 2, 3)"
                  }
                },
                {
                  "id": "0",
                  "label": {
                    "en": "0 (speeds 0, 1, 2)"
                  }
                }
              ],
              "hint": {
                "en": "Only used with DPT 5.010. Match the gateway parameter, for example the Intesis \"fan speed enumeration starts at\" setting."
              }
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Fan auto (DPT 1.001)"
          },
          "children": [
            {
              "id": "ga_fanauto_write",
              "type": "text",
              "label": {
                "en": "Control address"
              },
              "value": "",
              "hint": {
                "en": "1 = auto fan, 0 = manual. When set, Auto is added to the fan speed picker. Choosing a fixed speed sends 0 here first."
              }
            },
            {
              "id": "ga_fanauto_status",
              "type": "text",
              "label": {
                "en": "Status address"
              },
              "value": ""
            }
          ]
        },
        {
          "type": "group",
          "label": {
            "en": "Setpoint range"
          },
          "children": [
            {
              "id": "temp_min",
              "type": "number",
              "label": {
